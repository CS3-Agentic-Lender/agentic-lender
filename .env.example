# Copy to .env and fill in. Never commit .env.
# Add a line here whenever you add a key to your .env.

# Firebase (web/mobile client config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Firebase Admin (backend). Path to the service account JSON, kept outside the repo
GOOGLE_APPLICATION_CREDENTIALS=

# LLMs (keys are per person, free tiers are per account)
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
SERPER_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Browser origins al-ai answers CORS for, comma separated. Empty means only http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Payments (sandbox only)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Blockchain (testnet only, never a wallet holding real funds)
RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Core: audit hash on the registry (names only; the key is a testnet wallet)
CHAIN_RPC_URL=
CHAIN_REGISTRAR_PRIVATE_KEY=
AUDIT_REGISTRY_ADDRESS=
CHAIN_NETWORK=
