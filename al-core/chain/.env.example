# Copy to .env (never commit .env). Testnet wallets only.
# Only needed for the public testnet (Sprint 3); local work needs none of these.
AMOY_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# al-core's wallet address, given MINTER_ROLE at deploy. Defaults to the deployer.
MINTER_ADDRESS=
# The bank's address, which holds every note. Defaults to the deployer.
HOLDER_ADDRESS=
# For `npm run verify:amoy`: a free key from etherscan.io (it works for Polygon Amoy's explorer too).
ETHERSCAN_API_KEY=
# Optional: al-core's signing wallet key (minter and registrar), kept here to run al-core against Amoy from this machine.
# On AWS it is the CHAIN_MINTER_PRIVATE_KEY / CHAIN_REGISTRAR_PRIVATE_KEY secrets instead.
MINTER_PRIVATE_KEY=
