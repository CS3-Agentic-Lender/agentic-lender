rules_version = '2';

// Clients only read. Every write goes through al-core or al-ai with the Admin SDK,
// which bypasses these rules, so there is no `allow write` anywhere: all client
// writes are denied. Roles come from the `role` claim on the ID token, never from
// a document field. See al-core/SCHEMA.md and docs/api-design.md section 3.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    // Admins (AL-339) read the whole business and write nothing, like everyone else: their changes go through al-core.
    function isAdmin() {
      return isRole('admin');
    }

    // The parent application, for subcollections that don't carry brokerId themselves.
    function application(appId) {
      return get(/databases/$(database)/documents/applications/$(appId)).data;
    }

    // A broker doesn't read Drafts: a Draft is the borrower's working copy and there is nothing for a
    // broker to act on. Because a Draft closes the document to brokers, a broker's application query
    // must also exclude Drafts (where status != 'Draft'), or Firestore refuses it.
    function brokerOwns(brokerId, status) {
      return isRole('broker') && brokerId == request.auth.uid && status != 'Draft';
    }

    function canReadApplication(appId) {
      return isRole('underwriter') || isAdmin()
        || brokerOwns(application(appId).brokerId, application(appId).status)
        || (isRole('borrower') && application(appId).borrowerId == request.auth.uid);
    }

    // ---------- users ----------

    // A broker's query must filter on brokerId == their uid, or Firestore refuses it.
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isRole('underwriter')
        || isAdmin()
        || (isRole('broker') && resource.data.brokerId == request.auth.uid)
      );

      match /saved_checks/{checkId} {
        allow read: if signedIn() && request.auth.uid == userId;
      }
    }

    // ---------- applications ----------

    match /applications/{appId} {
      allow read: if isRole('underwriter') || isAdmin()
        || brokerOwns(resource.data.brokerId, resource.data.status)
        || (isRole('borrower') && resource.data.borrowerId == request.auth.uid);

      // Written once at mint. Not readable by the borrower.
      match /audit/{docId} {
        allow read: if isRole('underwriter') || isAdmin()
          || brokerOwns(application(appId).brokerId, application(appId).status);
      }

      match /messages/{messageId} {
        allow read: if canReadApplication(appId);
      }

      // What each person has read of the thread (AL-71): the time they last opened it. Written only by the API, and
      // readable only by the person it is about, and only while they can read the application.
      match /readState/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && canReadApplication(appId);
      }
    }

    // review/underwriting: matched at any depth so the portal's collection-group
    // query works. The document carries brokerId so the rule can check it without
    // reading the parent; a broker's query must filter on brokerId == their uid.
    //
    // review and ai_runs check a copied brokerId (ai_calls is underwriter-only); audit and messages read the
    // parent application. If a borrower's broker is ever reassigned, the copies must be
    // updated in the same write as the application's brokerId, or the old broker keeps
    // access to them.
    match /{path=**}/review/{docId} {
      allow read: if isRole('underwriter') || isAdmin()
        || (isRole('broker') && resource.data.brokerId == request.auth.uid);
    }

    // ---------- AI committee records ----------

    match /ai_runs/{runId} {
      allow read: if isRole('underwriter') || isAdmin()
        || (isRole('broker') && resource.data.brokerId == request.auth.uid);
    }

    // Underwriters only (AL-334), plus read-only admins (AL-339). The raw model calls (prompts, replies, tokens, retries) are the lender's working: the
    // team agreed on 23 Nov that a broker sees a committee's outcome and conditions, which are on ai_runs, and not its
    // calls, so this refuses them here as well as the portal hiding them.
    match /ai_calls/{callId} {
      allow read: if isRole('underwriter') || isAdmin();
    }

    // ---------- support and reviews ----------

    // The sender reads their own; admins read all of them (AL-339). Underwriters lost access then: no underwriter screen used it.
    // Closing, reopening and adding a note are al-core calls under /core/admin/support-requests/{reference}, never client writes.
    match /support_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);

      // Staff notes: admins only. The sender reads their request but never its notes.
      match /notes/{noteId} {
        allow read: if isAdmin();
      }
    }

    match /reviews/{reviewerId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == reviewerId);
    }

    // ---------- admin activity log ----------

    // One record per admin change, written by al-core. Admins only.
    match /admin_actions/{actionId} {
      allow read: if isAdmin();
    }
  }
}
