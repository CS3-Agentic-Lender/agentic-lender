// The app target's base settings (AL-184).
//
// The hosted Firebase settings are declared empty here and filled in by the gitignored Hosted.xcconfig
// next to this file, which only a machine that builds the demo (AL_BACKEND=HOSTED) needs. Copy
// Hosted.example.xcconfig to Hosted.xcconfig and fill it in from the hosted project's iOS app.
// AppInfo.plist passes these settings into the app's Info.plist.

// Which backend the app talks to (AL-184): LOCAL (the emulators and the local gateway) or HOSTED (the demo
// build). Set here, not on the target, so Hosted.xcconfig can switch it and Xcode's Run button builds what it says.
AL_BACKEND = LOCAL

AL_FIREBASE_PROJECT_ID =
AL_FIREBASE_API_KEY =
AL_FIREBASE_APP_ID =
AL_FIREBASE_SENDER_ID =
// Stripe's publishable test key (pk_test_…) for the appraisal fee (AL-148), on local and hosted builds alike.
AL_STRIPE_PUBLISHABLE_KEY =
// Real Google sign-in on the hosted build (AL-320): CLIENT_ID and REVERSED_CLIENT_ID from the same plist.
AL_GOOGLE_CLIENT_ID =
AL_GOOGLE_REVERSED_CLIENT_ID =

#include? "Hosted.xcconfig"
